{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crypto Bros",
  "version": "0.4.0",
  "identifier": "dev.cryptobros.workstation",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Crypto Bros",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 720,
        "backgroundColor": "#10120f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/crypto-bros.exe": "crypto-bros.exe"
    },
    "shortDescription": "SOL/USDC workstation with Phantom-approved trades",
    "category": "Finance",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENkYzRjg2MzlCNEY3NTIKUldSUzk3UTVoajl2UFJLRzVVV3hZOHB3dkxLa3JYbzBmUDJaRVVZSllMcmhzSlNQTEV0TW1PVGgK",
      "endpoints": [
        "https://raw.githubusercontent.com/Rayato159/crypto-bros/main/updates/windows.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
