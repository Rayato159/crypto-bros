# Template only. Agents must not read your real .env file.
# Wallet signing remains in Phantom. NEVER put a seed or private key here.
# Copy privately to the application's data directory as .env, then restart the worker.
CRYPTO_BROS_RPC_URL=https://api.mainnet-beta.solana.com
CRYPTO_BROS_JUPITER_API_KEY=
# Optional Resend notification service; runtime only, never returned to the UI.
CRYPTO_BROS_EMAIL_API_KEY=
CRYPTO_BROS_EMAIL_FROM=
CRYPTO_BROS_EMAIL_TO=
